{
  "name": "monorepo-expo-rn-ssr-csr",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run -w @app/shell build && npm run -w @app/module-products build && npm run -w @app/module-cart build && npm run -w @app/module-pdp build",
    "typecheck": "npm -ws run typecheck",
    "lint": "npm -ws run lint",
    "dev": "npm run -w @app/shell dev",
    "dev:shell:ssr": "npm run -w @app/shell dev:web",
    "dev:products:ssr": "npm run -w @app/module-products dev:web",
    "dev:cart:ssr": "npm run -w @app/module-cart dev:web",
    "dev:pdp:ssr": "npm run -w @app/module-pdp dev:web",
    "start:shell": "npm run -w @app/shell start",
    "start:products": "npm run -w @app/module-products start",
    "start:cart": "npm run -w @app/module-cart start",
    "start:pdp": "npm run -w @app/module-pdp start",
    "verdaccio:start": "npx verdaccio --config tools/verdaccio/config.yaml",
    "verdaccio:reset": "rm -rf .verdaccio/storage",
    "publish:verdaccio": "node tools/verdaccio/publish-all.mjs",
    "framework:ios:spm:runtime": "./scripts/generate-react-native-runtime-spm.sh",
    "framework:ios:spm:products": "MODULE_NAME=products MODULE_PACKAGE=@app/module-products MODULE_COMPONENT=ModuleProducts REGISTRY_VERSION=latest ./scripts/generate-module-framework-spm.sh",
    "framework:ios:spm:cart": "MODULE_NAME=cart MODULE_PACKAGE=@app/module-cart MODULE_COMPONENT=ModuleCart REGISTRY_VERSION=latest ./scripts/generate-module-framework-spm.sh",
    "framework:ios:spm:pdp": "MODULE_NAME=pdp MODULE_PACKAGE=@app/module-pdp MODULE_COMPONENT=ModulePDP REGISTRY_VERSION=latest ./scripts/generate-module-framework-spm.sh",
    "framework:ios:spm:all": "npm run framework:ios:spm:products & npm run framework:ios:spm:cart & npm run framework:ios:spm:pdp & wait",
    "framework:android:aar:host": "./scripts/generate-react-native-runtime-host-aar.sh",
    "framework:android:aar:host:publish:local": "./scripts/publish-aar.sh AAR=mkd-rn-host LOCATION=local",
    "framework:android:aar:host:publish:central": "./scripts/publish-aar.sh AAR=mkd-rn-host LOCATION=central",
    "framework:android:aar:products:publish:local": "./scripts/publish-aar.sh AAR=mkd-rn-module-products LOCATION=local",
    "framework:android:aar:products:publish:central": "./scripts/publish-aar.sh AAR=mkd-rn-module-products LOCATION=central",
    "framework:android:aar:cart:publish:local": "./scripts/publish-aar.sh AAR=mkd-rn-module-cart LOCATION=local",
    "framework:android:aar:cart:publish:central": "./scripts/publish-aar.sh AAR=mkd-rn-module-cart LOCATION=central",
    "framework:android:aar:pdp:publish:local": "./scripts/publish-aar.sh AAR=mkd-rn-module-pdp LOCATION=local",
    "framework:android:aar:pdp:publish:central": "./scripts/publish-aar.sh AAR=mkd-rn-module-pdp LOCATION=central",
    "framework:android:aar:products": "MODULE_NAME=products MODULE_PACKAGE=@app/module-products MODULE_COMPONENT=ModuleProducts REGISTRY_VERSION=latest ./scripts/generate-module-framework-aar.sh",
    "framework:android:aar:cart": "MODULE_NAME=cart MODULE_PACKAGE=@app/module-cart MODULE_COMPONENT=ModuleCart REGISTRY_VERSION=latest ./scripts/generate-module-framework-aar.sh",
    "framework:android:aar:pdp": "MODULE_NAME=pdp MODULE_PACKAGE=@app/module-pdp MODULE_COMPONENT=ModulePDP REGISTRY_VERSION=latest ./scripts/generate-module-framework-aar.sh",
    "framework:android:aar:all": "npm run framework:android:aar:products & npm run framework:android:aar:cart & npm run framework:android:aar:pdp & wait"
  },
  "dependencies": {
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/native-stack": "^7.6.1",
    "@reduxjs/toolkit": "2.9.2",
    "esbuild": "^0.25.11",
    "esbuild-register": "^3.6.0",
    "expo": "54.0.21",
    "express": "^5.1.0",
    "module-alias": "^2.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "0.21.2",
    "react-redux": "9.2.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^14.1.2",
    "@react-native/metro-config": "^0.81.5",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.0.2",
    "nodemon": "^3.1.10",
    "typescript": "5.9.3",
    "verdaccio": "^6.0.5"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
